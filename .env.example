# Copy this file to .env. Leave MONGODB_URI blank to use the built-in local demo database.
MONGODB_URI=
DB_MODE=auto
DB_NAME=nimma_bengaluru

PORT=3000
HTTPS_PORT=3443
ENABLE_HTTPS=true

# Optional. If blank, a random secret is saved under data/.secret for this installation.
JWT_SECRET=

# Optional SMS receipt after submitting a report. Contact details are not verified.
SMS_MODE=demo
SEED_DEMO_DATA=true
OPEN_BROWSER=false

# --- Hosting (only needed outside this computer; on Render most are automatic) ---
# TRUST_PROXY=1            # behind one proxy such as Render (default here: loopback)
# PUBLIC_URL=              # public address if not on Render (Render sets it automatically)

# --- Free-tier limits watched by Admin portal → Free-tier usage ---
# DB_STORAGE_LIMIT_MB=512        # MongoDB Atlas free cluster (0.5 GB)
# DB_TRANSFER_LIMIT_GB=10        # Atlas free: GB out per rolling 7 days
# HOST_HOURS_LIMIT=750           # Render free: instance hours per month
# HOST_BANDWIDTH_LIMIT_GB=100    # Render free: GB per month
