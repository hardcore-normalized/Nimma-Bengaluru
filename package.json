{
  "name": "nimma-bengaluru",
  "version": "1.0.0",
  "description": "Nimma Bengaluru - citizen-driven civic issue reporting and official response platform (academic prototype)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node scripts/launcher.js",
    "server": "node server/index.js",
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts && node scripts/stamp-build.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node scripts/reset-demo.js",
    "reset-demo": "node scripts/reset-demo.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server-core": "^10.4.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
